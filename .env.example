DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
CHAT_MODEL_ID=deepseek-v4-flash
CODING_MODEL_ID=deepseek-v4-flash
# Provider selection is independent from the model id. Built-ins: deepseek, anthropic.
CHAT_PROVIDER_ID=deepseek
CODING_PROVIDER_ID=deepseek
# Anthropic native Messages API (ANTHROPIC_AUTH_TOKEN is also accepted).
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional JSON list/object of additional OpenAI-compatible providers.
# MODEL_PROVIDERS_JSON={"local":{"base_url":"http://127.0.0.1:8000/v1","api_key":"","model":"model-name"}}
MODEL_PROVIDERS_JSON=
# Used for usage reports when the provider does not supply monetary cost.
MODEL_INPUT_COST_PER_MILLION=0
MODEL_OUTPUT_COST_PER_MILLION=0
TAVILY_API_KEY=

JWT_SECRET_KEY=replace-with-a-long-random-secret
ALLOW_ANONYMOUS=true
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=15
# Local loopback only. Disable in production and deliver reset tokens out-of-band.
PASSWORD_RESET_DEBUG=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=6
LOGIN_RATE_LIMIT=8
PASSWORD_RESET_RATE_LIMIT=4
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

MODEL_CONTEXT_TOKENS=32768
MODEL_MAX_TOKENS=4096
CONTEXT_SUMMARY_TOKENS=2400
CONTEXT_RECENT_MESSAGES=12
LLM_CONTEXT_COMPACTION=true
CONTEXT_COMPACTION_TRIGGER_RATIO=0.78
MEMORY_AUTO_CAPTURE=true
MEMORY_SEMANTIC_RECALL=true
MEMORY_RECALL_LIMIT=12
MEMORY_MIN_CONFIDENCE=0.6
MEMORY_MERGE_SIMILARITY=0.9
MEMORY_MAX_RECORDS_PER_USER=5000
MEMORY_COLLECTION_NAME=commchat_memories
RAG_INTENT_ROUTING=true
RAG_MIN_DENSE_SCORE=0.42
RAG_MIN_LEXICAL_SCORE=0.15
RAG_SEARCH_TIMEOUT_SECONDS=12
MODEL_REQUEST_TIMEOUT_SECONDS=90
DEEPSEEK_THINKING_MODE=enabled
DEEPSEEK_REASONING_EFFORT=low

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wireless_comm_ai
DATABASE_BACKEND=mysql
# Optional full SQLAlchemy URL; when set it takes precedence over DB_*.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AGENT_WORKER_MODE=external
AGENT_WORKER_CONCURRENCY=8
TASK_QUEUE_NAME=commchatbot:agent:queue
TASK_EVENT_POLL_MS=120

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OBSERVABILITY_ENABLED=true

HOOKS_CONFIG_PATH=
APPROVAL_TIMEOUT_SECONDS=300
WORKSPACE_IMPORT_ROOTS=D:\PyCharm\PythonProject\AIagent\CommChatBot
GIT_CLONE_TIMEOUT_SECONDS=180
SANDBOX_MODE=docker
SANDBOX_IMAGE=commchatbot-sandbox:0.8.0
SANDBOX_NETWORK=deny
SANDBOX_MEMORY_MB=2048
SANDBOX_MAX_PROCESSES=16
SANDBOX_CPU_SECONDS=120
SANDBOX_CPUS=1.0
SANDBOX_TMPFS_MB=256
SANDBOX_MAX_OUTPUT_BYTES=2000000
TERMINAL_MAX_PER_WORKSPACE=4
